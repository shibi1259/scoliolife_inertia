includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    level: 5

    paths:
        - app
        - config
        - database
        - routes

    # Laravel specific settings
    checkModelProperties: true
    
    # Additional type checks
    checkPhpDocMissingReturn: true
    
    treatPhpDocTypesAsCertain: false
    
    # Explicit return types and argument types are recommended
    checkImplicitMixed: true

    ignoreErrors:
        # Ignore Laravel's dynamic property access
        - '#Access to an undefined property [a-zA-Z0-9\\_]+::\$[a-zA-Z0-9_]+\.#'
        # Ignore Laravel's dynamic method calls
        - '#Call to an undefined method [a-zA-Z0-9\\_]+::[a-zA-Z0-9_]+\(\)\.#'
        # Ignore PHPDoc tag issues for now
        - '#PHPDoc tag @mixin contains unknown class#'
        # Common Laravel relationship return type issues
        - '#Property [a-zA-Z0-9\\_]+::\$[a-zA-Z0-9_]+ \(.*\) does not accept#'

    excludePaths:
        - database/migrations/*
        - tests/Feature/Auth/*
        - storage/*
        - bootstrap/cache/*
        
    # Analyze only files that are committed to git
    scanFiles:
        - artisan
        
    # Cache the results
    tmpDir: storage/framework/cache/larastan
    
    editorUrl: 'vscode://file/%%file%%:%%line%%'